# Copy this file to .env and run: php artisan key:generate

APP_NAME=Manystacks
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack

MANYSTACK_CONTACT=contact@example.com

DB_CONNECTION=sqlite
# Uncomment below and set DB_CONNECTION=mysql to use MySQL instead
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=manystacks
# DB_USERNAME=root
# DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=your-bucket-name
AWS_FOLDER=testing

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=
VITE_PUSHER_SCHEME=
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MS_REDIRECT_URI=http://localhost:8000/microsoft/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/google/auth/callback
PAYFIT_REDIRECT_URI=http://localhost:8000/payfit/auth/callback
